{
  "name": "studynotes",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "studynotes", "database_id": "PASTE_D1_ID_HERE" }
  ],
  "r2_buckets": [
    { "binding": "BOOKS", "bucket_name": "studynotes-books" }
  ],
  "vars": {
    "ACCESS_TEAM": "YOURTEAM.cloudflareaccess.com",
    "ACCESS_AUD": "PASTE_ACCESS_AUD_TAG_HERE"
  }
}
